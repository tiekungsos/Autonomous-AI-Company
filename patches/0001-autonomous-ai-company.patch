+-- Company layer tables. Additive only; never touches remote_agent_* tables.
+-- Timestamps are ISO-8601 TEXT so SQLite and PostgreSQL read the same shape.
+CREATE TABLE IF NOT EXISTS company_projects (
+  id TEXT PRIMARY KEY,
+  name TEXT NOT NULL,
+  description TEXT NOT NULL DEFAULT '',
+  requirements TEXT NOT NULL DEFAULT '',
+  repository_url TEXT,
+  tech_stack TEXT,
+  engine TEXT NOT NULL DEFAULT 'auto',
+  budget_usd REAL,
+  max_concurrency INTEGER NOT NULL DEFAULT 1,
+  phase TEXT NOT NULL DEFAULT 'PROJECT_CREATED',
+  phase_entered_at TEXT,
+  paused INTEGER NOT NULL DEFAULT 0,
+  codebase_id TEXT,
+  repo_path TEXT,
+  origin_url TEXT,
+  default_branch TEXT NOT NULL DEFAULT 'main',
+  last_error TEXT,
+  blocked_reason TEXT,
+  created_at TEXT NOT NULL,
+  updated_at TEXT NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS company_documents (
+  id TEXT PRIMARY KEY,
+  project_id TEXT NOT NULL,
+  kind TEXT NOT NULL,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL,
+  run_id TEXT,
+  created_at TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_company_documents_project ON company_documents(project_id, kind);
+
+CREATE TABLE IF NOT EXISTS company_milestones (
+  id TEXT PRIMARY KEY,
+  project_id TEXT NOT NULL,
+  seq INTEGER NOT NULL,
+  title TEXT NOT NULL,
+  description TEXT NOT NULL DEFAULT '',
+  created_at TEXT NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS company_tasks (
+  id TEXT PRIMARY KEY,
+  project_id TEXT NOT NULL,
+  milestone_id TEXT,
+  key TEXT NOT NULL,
+  title TEXT NOT NULL,
+  description TEXT NOT NULL DEFAULT '',
+  acceptance TEXT NOT NULL DEFAULT '',
+  role TEXT NOT NULL DEFAULT 'developer',
+  kind TEXT NOT NULL DEFAULT 'feature',
+  size TEXT NOT NULL DEFAULT 'medium',
+  status TEXT NOT NULL DEFAULT 'BACKLOG',
+  priority INTEGER NOT NULL DEFAULT 100,
+  attempts INTEGER NOT NULL DEFAULT 0,
+  attempt_base INTEGER NOT NULL DEFAULT 0,
+  repair_iterations INTEGER NOT NULL DEFAULT 0,
+  engine TEXT,
+  branch TEXT,
+  run_id TEXT,
+  last_verdict TEXT,
+  last_summary TEXT,
+  last_error TEXT,
+  created_at TEXT NOT NULL,
+  updated_at TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_company_tasks_project ON company_tasks(project_id, status);
+
+CREATE TABLE IF NOT EXISTS company_task_deps (
+  task_id TEXT NOT NULL,
+  depends_on_task_id TEXT NOT NULL,
+  PRIMARY KEY (task_id, depends_on_task_id)
+);
+
+CREATE TABLE IF NOT EXISTS company_executions (
+  id TEXT PRIMARY KEY,
+  idempotency_key TEXT NOT NULL UNIQUE,
+  project_id TEXT NOT NULL,
+  task_id TEXT,
+  phase TEXT NOT NULL,
+  role TEXT NOT NULL,
+  engine TEXT NOT NULL,
+  workflow_name TEXT NOT NULL,
+  conversation_id TEXT,
+  run_id TEXT,
+  status TEXT NOT NULL DEFAULT 'dispatched',
+  verdict TEXT,
+  summary TEXT,
+  error TEXT,
+  tokens_in INTEGER,
+  tokens_out INTEGER,
+  cost_usd REAL,
+  cost_estimated_usd REAL,
+  started_at TEXT NOT NULL,
+  finished_at TEXT,
+  last_seen_at TEXT
+);
+CREATE INDEX IF NOT EXISTS idx_company_executions_project ON company_executions(project_id, status);
+CREATE INDEX IF NOT EXISTS idx_company_executions_run ON company_executions(run_id);
+
+CREATE TABLE IF NOT EXISTS company_deployments (
+  id TEXT PRIMARY KEY,
+  project_id TEXT NOT NULL,
+  run_id TEXT,
+  compose_project TEXT NOT NULL,
+  status TEXT NOT NULL,
+  url TEXT,
+  health TEXT,
+  created_at TEXT NOT NULL,
+  updated_at TEXT NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS company_events (
+  id TEXT PRIMARY KEY,
+  project_id TEXT,
+  task_id TEXT,
+  execution_id TEXT,
+  level TEXT NOT NULL DEFAULT 'info',
+  kind TEXT NOT NULL,
+  message TEXT NOT NULL,
+  data TEXT,
+  created_at TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_company_events_project ON company_events(project_id, created_at);
