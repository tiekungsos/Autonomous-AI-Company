+import { engineStatuses, NoEngineAvailableError, roleBindings, roleProfile, selectEngine } from './engines';
+import { ensureProjectRepo, integrateBranch, syncCheckout } from './repo';
+import { readLimits, taskSizeFromEstimate, type CompanyLimits, type Execution, type Project, type ProjectPhase, type Task, type TaskSize } from './types';
+
+const log = createLogger('company.scheduler');
+type Run = NonNullable<Awaited<ReturnType<typeof readRun>>>;
+type Json = Record<string, unknown>;
+
+const TERMINAL_PHASES: ReadonlySet<ProjectPhase> = new Set(['COMPLETED', 'CANCELLED']);
