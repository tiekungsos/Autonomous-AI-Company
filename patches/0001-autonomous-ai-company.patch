+import { useCallback, useEffect, useState, type ReactElement, type ReactNode } from 'react';
+import { Link } from 'react-router';
+import { errorDetail } from '../../lib/http';
+import type { CompanyExecution, CompanyTask } from '../../skills/company';
+
+/** Poll a loader on an interval; returns data, error and a manual refresh. */
+export function usePoll<T>(loader: () => Promise<T>, intervalMs = 5000, deps: unknown[] = []): { data: T | undefined; error: string | null; refresh: () => void; loading: boolean } {
+  const [data, setData] = useState<T | undefined>(undefined);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [nonce, setNonce] = useState(0);
+  const refresh = useCallback(() => {
+    setNonce(n => n + 1);
+  }, []);
+  useEffect(() => {
+    let cancelled = false;
+    const run = async (): Promise<void> => {
+      try {
+        const next = await loader();
+        if (!cancelled) {
+          setData(next);
+          setError(null);
+        }
+      } catch (e) {
+        if (!cancelled) setError(errorDetail(e));
+      } finally {
+        if (!cancelled) setLoading(false);
+      }
+    };
+    void run();
+    const timer = setInterval(() => void run(), intervalMs);
+    return () => {
+      cancelled = true;
+      clearInterval(timer);
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [intervalMs, nonce, ...deps]);
+  return { data, error, refresh, loading };
+}
+
+export function Card({ title, children, actions }: { title: string; children: ReactNode; actions?: ReactNode }): ReactElement {
+  return (
+    <section className="rounded-[15px] border border-border bg-surface px-5 py-4">
+      <div className="mb-3 flex items-center justify-between gap-3">
+        <h2 className="text-[15px] font-extrabold tracking-[-0.2px] text-text-primary">{title}</h2>
+        {actions}
+      </div>
+      {children}
+    </section>
+  );
+}
+
+export function Stat({ label, value, hint }: { label: string; value: string | number; hint?: string }): ReactElement {
+  return (
+    <div className="rounded-[12px] border border-border bg-surface-inset px-4 py-3">
+      <div className="text-[11px] font-medium uppercase tracking-widest text-text-tertiary">{label}</div>
+      <div className="mt-1 text-[22px] font-extrabold text-text-primary">{value}</div>
+      {hint ? <div className="text-[11px] text-text-tertiary">{hint}</div> : null}
+    </div>
+  );
+}
+
+const PHASE_ORDER = ['PROJECT_CREATED', 'REQUIREMENTS_ANALYSIS', 'SRS_GENERATION', 'ARCHITECTURE_DESIGN', 'DEVELOPMENT_PLANNING', 'TASK_BREAKDOWN', 'AUTONOMOUS_DEVELOPMENT', 'INTEGRATION', 'AUTOMATED_QA', 'SECURITY_REVIEW', 'STAGING_DEPLOYMENT', 'ACCEPTANCE_VERIFICATION', 'DELIVERY', 'COMPLETED'];
+
+export function phaseLabel(phase: string): string {
+  return phase.toLowerCase().replace(/_/g, ' ');
+}
+
+export function PhaseBadge({ phase, paused }: { phase: string; paused?: number }): ReactElement {
+  const tone =
+    phase === 'COMPLETED' ? 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300'
+    : phase === 'BLOCKED' ? 'border-red-500/40 bg-red-500/10 text-red-300'
+    : phase === 'CANCELLED' ? 'border-border text-text-tertiary'
+    : paused ? 'border-amber-500/40 bg-amber-500/10 text-amber-300'
+    : 'border-sky-500/40 bg-sky-500/10 text-sky-300';
+  return <span className={`rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest ${tone}`}>{paused && !['COMPLETED', 'BLOCKED', 'CANCELLED'].includes(phase) ? `paused · ${phaseLabel(phase)}` : phaseLabel(phase)}</span>;
+}
+
+export function Lifecycle({ phase }: { phase: string }): ReactElement {
+  const index = PHASE_ORDER.indexOf(phase);
+  return (
+    <ol className="flex flex-wrap gap-1">
+      {PHASE_ORDER.map((step, i) => {
+        const state = phase === 'BLOCKED' || phase === 'CANCELLED' ? (i < PHASE_ORDER.indexOf('AUTONOMOUS_DEVELOPMENT') ? 'done' : 'todo') : i < index ? 'done' : i === index ? 'now' : 'todo';
+        return (
+          <li key={step} className={`rounded px-2 py-0.5 text-[10px] uppercase tracking-wide ${state === 'done' ? 'bg-emerald-500/15 text-emerald-300' : state === 'now' ? 'bg-sky-500/20 text-sky-200 ring-1 ring-sky-400/50' : 'bg-surface-inset text-text-tertiary'}`}>
+            {phaseLabel(step)}
+          </li>
+        );
+      })}
+    </ol>
+  );
+}
+
+export function StatusPill({ status }: { status: string }): ReactElement {
+  const tone =
+    ['COMPLETED', 'completed', 'healthy', 'green', 'succeeded'].includes(status) ? 'text-emerald-300 border-emerald-500/40'
+    : ['RUNNING', 'running', 'dispatched', 'REVIEW', 'TESTING', 'QUEUED'].includes(status) ? 'text-sky-300 border-sky-500/40'
+    : ['BLOCKED', 'FAILED', 'failed', 'stale', 'CANCELLED', 'cancelled'].includes(status) ? 'text-red-300 border-red-500/40'
+    : 'text-text-secondary border-border';
+  return <span className={`rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest ${tone}`}>{status}</span>;
+}
+
+export function RunLink({ runId, projectCodebaseId }: { runId: string | null; projectCodebaseId?: string | null }): ReactElement | null {
+  if (!runId) return null;
+  const to = projectCodebaseId ? `/console/p/${projectCodebaseId}/r/${runId}` : `/console/r/${runId}`;
+  return (
+    <Link to={to} className="font-mono text-[11px] text-sky-300 hover:underline" title="Open the Archon run (logs, artifacts, provider events)">
+      run {runId.slice(0, 8)}
+    </Link>
