+/**
+ * Lifecycle test with Archon's dispatch, run reads, git integration and engine
+ * checks replaced by in-memory fakes. Proves the scheduler's state machine:
+ * intake -> backlog -> dependency-ordered dispatch -> integration -> gates ->
+ * deployment -> delivery -> COMPLETED, plus retry and repair limits.
+ */
+import { afterAll, beforeAll, beforeEach, describe, expect, mock, test } from 'bun:test';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+type Json = Record<string, unknown>;
+const dispatched: { workflowName: string; inputs: Record<string, string>; conversationDbId: string; aliases?: Record<string, string>; tiers?: Record<string, string>; adoptRunId?: string }[] = [];
+const runs = new Map<string, { id: string; status: string; outcome: string | null; metadata: Json; started_at: Date; last_activity_at: Date | null; output_root: string | null }>();
+const conversationRuns = new Map<string, string>();
+const returns = new Map<string, Json>();
+let conversationCounter = 0;
+let lastReadRunId: string | null = null;
+let integrateResult = { merged: true, head: 'abc123', conflict: false, detail: 'merged' };
+
+mock.module('./dispatch', () => ({
+  configureDispatch: () => undefined,
+  dispatchWorkflow: async (request: { workflowName: string; inputs?: Record<string, string>; aliases?: Record<string, string>; tiers?: Record<string, string>; adoptRunId?: string }) => {
+    conversationCounter += 1;
+    const conversationDbId = `conv-${String(conversationCounter)}`;
+    dispatched.push({ workflowName: request.workflowName, inputs: request.inputs ?? {}, conversationDbId, aliases: request.aliases, tiers: request.tiers, adoptRunId: request.adoptRunId });
+    return { conversationId: `web-${conversationDbId}`, conversationDbId, status: 'started' };
+  },
