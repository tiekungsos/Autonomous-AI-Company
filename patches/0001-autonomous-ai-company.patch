+        <Stat label="Executions" value={executions.length} hint={`${String(executions.filter(e => ['running', 'dispatched'].includes(e.status)).length)} running`} />
+        <Stat label="Spend" value={money(spend.measured + spend.estimated)} hint={project.budget_usd !== null ? `of ${money(project.budget_usd)} budget` : 'no budget set'} />
+        <Stat label="Engine" value={project.engine} hint={`concurrency ${String(project.max_concurrency)}`} />
+        <Stat label="Repository" value={project.default_branch} hint={project.origin_url ?? 'not created yet'} />
+      </div>
