+export function startScheduler(): void {
+  if (timer) return;
+  timer = setInterval(() => {
+    void tick().catch(error => log.error({ err: error }, 'company.tick_failed'));
+  }, limits.tickMs);
+  log.info({ tickMs: limits.tickMs, limits }, 'company.scheduler_started');
