+/**
+ * Company layer entrypoint: schema, in-process dispatch, routes, role aliases in
+ * Archon's config, and the scheduler loop. Mounted once from server/src/index.ts.
+ */
+import type { OpenAPIHono } from '@hono/zod-openapi';
+import { loadConfig, updateGlobalConfig } from '@archon/core';
+import { createLogger } from '@archon/paths';
+import { ensureSchema } from './db';
+import { configureDispatch, type DispatchDeps } from './dispatch';
+import { loadRoles, modelOverride } from './engines';
+import { registerCompanyRoutes } from './routes';
+import { startScheduler } from './scheduler';
+
+const log = createLogger('company');
+
+/**
+ * `agents/roles.yaml` owns the role aliases (`@ceo`, `@developer`, ...): every boot writes them
+ * into the install config so manual runs and the console's AI Settings show the same binding
+ * the scheduler uses. Only aliases that differ are written.
+ */
+export async function ensureRoleAliases(): Promise<string[]> {
+  const config = await loadConfig();
+  const existing = (config as { aliases?: Record<string, { provider?: string; model?: string }> }).aliases ?? {};
+  const changed: Record<string, { provider: string; model: string }> = {};
+  const override = modelOverride();
+  for (const role of Object.values(loadRoles().roles)) {
+    const wanted = override
+      ? { provider: override.engine, model: override.model }
+      : { provider: role.engine, model: role.models[role.engine] ?? role.model };
+    const current = existing[role.alias];
+    if (current?.provider !== wanted.provider || current.model !== wanted.model) changed[role.alias] = wanted;
+  }
+  const names = Object.keys(changed);
+  if (names.length > 0) await updateGlobalConfig({ aliases: changed });
+  return names;
+}
+
+export async function startCompanyLayer(app: OpenAPIHono, deps: DispatchDeps): Promise<void> {
+  await ensureSchema();
+  configureDispatch(deps);
+  registerCompanyRoutes(app);
+  try {
+    const added = await ensureRoleAliases();
+    if (added.length > 0) log.info({ aliases: added }, 'company.role_aliases_added');
+  } catch (error) {
+    log.warn({ err: error }, 'company.role_aliases_failed');
+  }
+  if (process.env.COMPANY_SCHEDULER === 'off') {
+    log.info('company.scheduler_disabled');
+  } else {
+    startScheduler();
+  }
+  const override = modelOverride();
+  if (override) log.warn({ override }, 'company.model_override_active');
+  log.info('company.layer_ready');
+}
