+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { loadRoles, roleBindings, roleEngineSelectable, selectEngine, type EngineStatus } from './engines';
+
+const yaml = `
+defaults: { fallback: [devin, claude, codex] }
+roles:
+  ceo: { title: CEO, alias: "@ceo", engine: claude, model: opus, models: { claude: opus, devin: claude-opus-5-5-high } }
+  developer: { title: Dev, alias: "@developer", engine: devin, model: swe-2-high, models: { devin: swe-2-high, claude: sonnet } }
+  security_engineer: { title: Sec, alias: "@security", engine: codex, model: gpt-5.6, models: { codex: gpt-5.6, devin: swe-2-high } }
+tiers:
+  devin: { small: swe-2-high, medium: deepseek-v4-1-flash-high, large: gemini-4-argon-high }
+  claude: { small: haiku, medium: sonnet, large: opus }
+`;
+const dir = mkdtempSync(join(tmpdir(), 'roles-'));
+const path = join(dir, 'roles.yaml');
+writeFileSync(path, yaml);
+const config = loadRoles(path);
+const statuses: EngineStatus[] = [
+  { id: 'devin', displayName: 'Devin', available: true, reason: 'credential usable' },
+  { id: 'claude', displayName: 'Claude', available: false, reason: 'credential not checked by provider' },
+  { id: 'codex', displayName: 'Codex', available: false, reason: 'not_connected' },
+];
+
+describe('role bindings', () => {
+  test('tiers follow the run engine and the task size', () => {
+    expect(roleBindings('devin', config, 'medium', statuses).tiers).toEqual({ small: 'devin/swe-2-high', medium: 'devin/deepseek-v4-1-flash-high', large: 'devin/deepseek-v4-1-flash-high' });
+    expect(roleBindings('devin', config, 'large', statuses).tiers.large).toBe('devin/gemini-4-argon-high');
+  });
+  test('each alias binds its own engine when selectable, else the run engine', () => {
+    const { aliases } = roleBindings('devin', config, undefined, statuses);
+    expect(aliases['@ceo']).toBe('claude/opus');
+    expect(aliases['@developer']).toBe('devin/swe-2-high');
+    expect(aliases['@security']).toBe('devin/swe-2-high');
+    expect(roleEngineSelectable('claude', statuses)).toBe(true);
+    expect(roleEngineSelectable('codex', statuses)).toBe(false);
+  });
+  test('selectEngine prefers the role engine, then the fallback order, among usable engines', () => {
+    expect(selectEngine('auto', config.roles.developer, statuses, config)).toBe('devin');
+    expect(selectEngine('auto', config.roles.ceo, statuses, config)).toBe('devin');
+    expect(() => selectEngine('codex', config.roles.ceo, statuses, config)).toThrow(/not available/);
+  });
+  test('roles.yaml is re-read when it changes', () => {
+    writeFileSync(path, yaml.replace('engine: claude, model: opus', 'engine: devin, model: swe-2-high'));
+    const future = new Date(Date.now() + 2000);
+    require('node:fs').utimesSync(path, future, future);
+    expect(loadRoles(path).roles.ceo.engine).toBe('devin');
+  });
+  test('COMPANY_MODEL_OVERRIDE binds every role, tier and size to one model', () => {
+    process.env.COMPANY_MODEL_OVERRIDE = 'devin/swe-2-high';
+    try {
+      const fresh = loadRoles(path);
+      const bound = roleBindings('devin', fresh, 'large', statuses);
+      expect(bound.tiers).toEqual({ small: 'devin/swe-2-high', medium: 'devin/swe-2-high', large: 'devin/swe-2-high' });
+      expect(new Set(Object.values(bound.aliases))).toEqual(new Set(['devin/swe-2-high']));
+      expect(selectEngine('auto', fresh.roles.ceo, statuses, fresh)).toBe('devin');
+    } finally {
+      delete process.env.COMPANY_MODEL_OVERRIDE;
+    }
+  });
+});
diff --git a/packages/server/src/company/engines.ts b/packages/server/src/company/engines.ts
