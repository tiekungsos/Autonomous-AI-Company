+            <div><div className="text-[10px] uppercase tracking-widest text-text-tertiary">Depends on</div>{dependencies.filter(d => d.task_id === task.id).map(d => keyOf.get(d.depends_on_task_id)).join(', ') || 'nothing'}</div>
+            <div className="md:col-span-2"><div className="text-[10px] uppercase tracking-widest text-text-tertiary">Description</div><pre className="whitespace-pre-wrap font-sans">{task.description}</pre></div>
+            <div className="md:col-span-2"><div className="text-[10px] uppercase tracking-widest text-text-tertiary">Acceptance</div><pre className="whitespace-pre-wrap font-sans">{task.acceptance}</pre></div>
+            {task.last_summary ? <div className="md:col-span-2"><div className="text-[10px] uppercase tracking-widest text-text-tertiary">Latest result</div>{task.last_summary}</div> : null}
+            {task.last_error ? <div className="md:col-span-2 text-red-300">{task.last_error}</div> : null}
+          </div>
+          <div className="mt-3"><div className="mb-1 text-[10px] uppercase tracking-widest text-text-tertiary">Execution history</div><ExecutionTable executions={executions.filter(e => e.task_id === task.id)} codebaseId={project.codebase_id} /></div>
+        </Card>
+      ) : null}
+      <Card title="Executions (Archon runs)"><ExecutionTable executions={executions} codebaseId={project.codebase_id} /></Card>
+      <div className="grid gap-4 md:grid-cols-2">
+        <Card title="Documents and delivery artifacts">
+          {documents.length === 0 ? <p className="text-[12px] text-text-tertiary">Produced during intake and delivery.</p> : (
+            <ul className="space-y-1">{documents.map(d => <li key={d.id}><button className="text-[12px] text-sky-300 hover:underline" onClick={() => void openDoc(d.id)}>{d.kind} · {d.title}</button> <span className="font-mono text-[10px] text-text-tertiary">{String(d.size ?? 0)} chars</span> <RunLink runId={d.run_id} projectCodebaseId={project.codebase_id} /></li>)}</ul>
+          )}
