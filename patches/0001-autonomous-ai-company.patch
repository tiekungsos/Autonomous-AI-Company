+
+/** One pass: observe open executions, then advance every active project. Safe to call concurrently (coalesces). */
+export async function tick(): Promise<{ observed: number; projects: number }> {
+  if (ticking) return { observed: 0, projects: 0 };
+  ticking = true;
+  try {
+    const open = await db.listOpenExecutions();
+    for (const execution of open) {
+      try {
+        await observeExecution(execution);
+      } catch (error) {
+        log.error({ err: error, executionId: execution.id }, 'company.observe_failed');
+      }
+    }
