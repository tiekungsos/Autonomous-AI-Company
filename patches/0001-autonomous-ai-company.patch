+          {grouped.map(({ col, items }) => (
+            <div key={col} className="min-w-0 rounded-[10px] border border-border/60 bg-surface-inset/40 p-2">
+              <div className="mb-2 flex items-center justify-between text-[10px] uppercase tracking-widest text-text-tertiary"><span>{col}</span><span className="font-mono">{items.length}</span></div>
+              <div className="flex flex-col gap-2">{items.map(t => <TaskCard key={t.id} task={t} codebaseId={project.codebase_id} onOpen={setTask} />)}</div>
+            </div>
+          ))}
+        </div>
+      </Card>
