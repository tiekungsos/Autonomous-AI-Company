+      <div className="mt-1 font-mono text-[10px] text-text-tertiary">{role.alias} · {role.engine}/{role.model}</div>
+      {role.current ? <div className="mt-1 text-[11px] text-sky-200">Now: {role.current.workflow_name} ({role.current.phase}){role.current.task_id ? ' · task' : ''}</div> : <div className="mt-1 text-[11px] text-text-tertiary">Idle (instantiated on demand)</div>}
+      <div className="mt-1 text-[11px] text-text-tertiary">History: {role.history.completed} completed · {role.history.failed} failed · {role.history.total} total</div>
+      {role.responsibilities ? <div className="mt-1 text-[11px] text-text-secondary">{role.responsibilities.join(' · ')}</div> : null}
+    </div>
+  );
+  return (
+    <div className="flex flex-col gap-4">
+      <ErrorNote error={error} />
+      <p className="text-[12px] text-text-secondary">Every role is a logical agent: a workflow node with its own instructions, engine and model (agents/roles.yaml). Status and history come from real execution records.</p>
+      {ceo ? <div className="mx-auto w-full max-w-[420px]"><RoleCard role={ceo} /></div> : null}
+      <div className="grid gap-3 md:grid-cols-4">{managers.map(r => <RoleCard key={r.id} role={r} />)}</div>
+      <div className="grid gap-3 md:grid-cols-4">{staff.map(r => <RoleCard key={r.id} role={r} />)}</div>
+      {data ? <Card title="Model tiers per engine"><pre className="text-[11px] text-text-secondary">{JSON.stringify(data.tiers, null, 2)}</pre></Card> : null}
+    </div>
