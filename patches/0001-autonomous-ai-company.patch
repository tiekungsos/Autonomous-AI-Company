+      {project.blocked_reason ? <p className="rounded border border-red-500/40 bg-red-500/10 px-3 py-2 text-[12px] text-red-200">{project.blocked_reason}</p> : null}
+      {project.last_error ? <p className="rounded border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-[12px] text-amber-200">{project.last_error}</p> : null}
+      <Card title="Lifecycle"><Lifecycle phase={project.phase} /></Card>
+      <div className="grid grid-cols-2 gap-3 md:grid-cols-5">
