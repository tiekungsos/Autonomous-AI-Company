+/**
+ * `/api/company/*`: the Company Management API, registered on Archon's own
+ * OpenAPIHono app so the console's generated types, auth gate and error hook
+ * apply unchanged.
+ */
+import { createRoute, z, type OpenAPIHono } from '@hono/zod-openapi';
+import { createSqlWorkflowOperations } from '@archon/core/workflows/sql-host';
+import { createLogger } from '@archon/paths';
+import * as db from './db';
+import { engineStatuses, loadRoles, resetEngineStatusCache } from './engines';
+import { currentLimits, resumeProject, tick } from './scheduler';
+import { ENGINES, PROJECT_PHASES, TASK_STATUSES } from './types';
+
+const log = createLogger('company.routes');
+
+const projectSchema = z
+  .object({
+    id: z.string(),
+    name: z.string(),
+    description: z.string(),
+    requirements: z.string(),
+    repository_url: z.string().nullable(),
+    tech_stack: z.string().nullable(),
+    engine: z.string(),
+    budget_usd: z.number().nullable(),
+    max_concurrency: z.number(),
+    phase: z.enum(PROJECT_PHASES),
+    phase_entered_at: z.string().nullable(),
