@@ -0,0 +1,197 @@
+/**
+ * Company layer domain types. The phase and task status vocabularies are the
+ * persisted wire values; the dashboard and tests read them by name.
+ */
+export const PROJECT_PHASES = [
+  'PROJECT_CREATED',
+  'REQUIREMENTS_ANALYSIS',
+  'SRS_GENERATION',
+  'ARCHITECTURE_DESIGN',
+  'DEVELOPMENT_PLANNING',
+  'TASK_BREAKDOWN',
+  'AUTONOMOUS_DEVELOPMENT',
+  'INTEGRATION',
+  'AUTOMATED_QA',
+  'SECURITY_REVIEW',
+  'STAGING_DEPLOYMENT',
+  'ACCEPTANCE_VERIFICATION',
+  'DELIVERY',
+  'COMPLETED',
+  'BLOCKED',
+  'CANCELLED',
+] as const;
+export type ProjectPhase = (typeof PROJECT_PHASES)[number];
+
+export const TASK_STATUSES = [
+  'BACKLOG',
+  'READY',
+  'QUEUED',
+  'RUNNING',
+  'REVIEW',
+  'TESTING',
+  'COMPLETED',
+  'FAILED',
+  'BLOCKED',
+  'CANCELLED',
+] as const;
+export type TaskStatus = (typeof TASK_STATUSES)[number];
+
+export const ENGINES = ['auto', 'devin', 'claude', 'codex', 'pi', 'opencode'] as const;
+export type Engine = (typeof ENGINES)[number];
+
+export const EXECUTION_STATUSES = ['dispatched', 'running', 'completed', 'failed', 'cancelled', 'stale'] as const;
+export type ExecutionStatus = (typeof EXECUTION_STATUSES)[number];
+
+export interface Project {
+  id: string;
+  name: string;
+  description: string;
+  requirements: string;
+  repository_url: string | null;
+  tech_stack: string | null;
+  engine: Engine;
+  budget_usd: number | null;
+  max_concurrency: number;
+  phase: ProjectPhase;
+  /** When the project entered its current phase; gate dispatches are keyed on it (restart-safe). */
+  phase_entered_at: string | null;
+  paused: number;
+  codebase_id: string | null;
+  repo_path: string | null;
+  origin_url: string | null;
+  default_branch: string;
+  last_error: string | null;
+  blocked_reason: string | null;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface Document {
+  id: string;
+  project_id: string;
+  kind: string;
+  title: string;
+  content: string;
+  run_id: string | null;
+  created_at: string;
+}
+
+export interface Milestone {
+  id: string;
+  project_id: string;
+  seq: number;
+  title: string;
+  description: string;
+  created_at: string;
+}
+
+export interface Task {
+  id: string;
+  project_id: string;
+  milestone_id: string | null;
+  key: string;
+  title: string;
+  description: string;
+  acceptance: string;
+  role: string;
+  kind: string;
+  /** small | medium | large: selects the implementation model for engines whose tiers map task sizes. */
+  size: string;
+  status: TaskStatus;
+  priority: number;
+  /** Monotonic dispatch counter; also the idempotency key suffix, so it is never reset. */
+  attempts: number;
+  /** Value of `attempts` at the last resume; the retry limit counts from here. */
+  attempt_base: number;
+  repair_iterations: number;
+  engine: string | null;
+  branch: string | null;
+  run_id: string | null;
+  last_verdict: string | null;
+  last_summary: string | null;
+  last_error: string | null;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface Execution {
+  id: string;
+  idempotency_key: string;
+  project_id: string;
+  task_id: string | null;
+  phase: string;
+  role: string;
+  engine: string;
+  workflow_name: string;
+  conversation_id: string | null;
+  run_id: string | null;
+  status: ExecutionStatus;
+  verdict: string | null;
+  summary: string | null;
+  error: string | null;
+  tokens_in: number | null;
+  tokens_out: number | null;
+  cost_usd: number | null;
+  cost_estimated_usd: number | null;
+  started_at: string;
+  finished_at: string | null;
+  last_seen_at: string | null;
+}
+
+export interface Deployment {
+  id: string;
+  project_id: string;
+  run_id: string | null;
+  compose_project: string;
+  status: string;
+  url: string | null;
+  health: string | null;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface CompanyEvent {
+  id: string;
+  project_id: string | null;
+  task_id: string | null;
+  execution_id: string | null;
+  level: 'info' | 'warn' | 'error';
+  kind: string;
+  message: string;
+  data: string | null;
+  created_at: string;
+}
+
+/** Configurable limits (section 22 of the brief). Read once from the environment. */
+export interface CompanyLimits {
+  maxConcurrentAgents: number;
+  maxTaskRetries: number;
+  maxRepairIterations: number;
+  maxAgentExecutionMinutes: number;
+  tickMs: number;
+}
+
+export function readLimits(env: NodeJS.ProcessEnv = process.env): CompanyLimits {
+  const int = (key: string, fallback: number): number => {
+    const raw = env[key];
+    const value = raw === undefined ? NaN : Number.parseInt(raw, 10);
+    return Number.isFinite(value) && value > 0 ? value : fallback;
+  };
+  return {
+    maxConcurrentAgents: int('MAX_CONCURRENT_AGENTS', 3),
+    maxTaskRetries: int('MAX_TASK_RETRIES', 3),
+    maxRepairIterations: int('MAX_REPAIR_ITERATIONS', 5),
+    maxAgentExecutionMinutes: int('MAX_AGENT_EXECUTION_MINUTES', 60),
+    tickMs: int('COMPANY_TICK_MS', 5000),
+  };
+}
+
+export const TASK_SIZES = ['small', 'medium', 'large'] as const;
+export type TaskSize = (typeof TASK_SIZES)[number];
+
+/** Planner estimates become sizes: up to 1.5 h small, up to 4 h medium, above that large. */
+export function taskSizeFromEstimate(hours: unknown): TaskSize {
+  const value = typeof hours === 'number' && Number.isFinite(hours) ? hours : NaN;
+  if (Number.isNaN(value)) return 'medium';
+  return value <= 1.5 ? 'small' : value <= 4 ? 'medium' : 'large';
+}
