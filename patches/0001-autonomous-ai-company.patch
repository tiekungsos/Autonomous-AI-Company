+/**
+ * The company scheduler: one tick loop inside the server process that advances
+ * every project through its lifecycle, dispatches Archon runs for ready work,
+ * observes the runs Archon persists, integrates green task branches, and creates
+ * repair tasks from failed gates. Every dispatch is recorded before it happens
+ * (idempotency key), so a restart reconciles instead of re-dispatching.
+ */
+import { randomUUID } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
