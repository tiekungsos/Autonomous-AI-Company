+      </div>
+      <Card title="Activity log">
+        <ul className="max-h-[360px] space-y-1 overflow-auto">{events.map(e => <li key={e.id} className="flex gap-3 text-[12px]"><span className="shrink-0 font-mono text-[10px] text-text-tertiary">{new Date(e.created_at).toLocaleString()}</span><span className={`shrink-0 font-mono text-[10px] ${e.level === 'error' ? 'text-red-300' : e.level === 'warn' ? 'text-amber-300' : 'text-text-tertiary'}`}>{e.kind}</span><span className="text-text-secondary">{e.message}</span></li>)}</ul>
+      </Card>
+    </div>
+  );
+}
