+        <div className="flex flex-wrap gap-2">
+          {!terminal && project.paused === 1 && project.phase !== 'BLOCKED' ? <button className={PRIMARY} disabled={busy !== null} onClick={() => void act('start')}>{project.phase === 'PROJECT_CREATED' ? 'Start autonomous development' : 'Resume'}</button> : null}
+          {project.phase === 'BLOCKED' ? <button className={PRIMARY} disabled={busy !== null} onClick={() => void act('resume')}>Resume (reset blocked tasks)</button> : null}
+          {!terminal && project.paused === 0 ? <button className={BUTTON} disabled={busy !== null} onClick={() => void act('pause')}>Pause</button> : null}
+          {!terminal ? <button className={BUTTON} disabled={busy !== null} onClick={() => void act('cancel')}>Cancel project</button> : null}
+        </div>
+      </div>
