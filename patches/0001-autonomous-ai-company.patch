+/**
+ * Git operations the company layer owns: project repositories under
+ * `$ARCHON_HOME/company/projects/<id>/`, a bare origin for projects without a
+ * remote, and integration of task branches. Nothing here touches paths outside
+ * that directory.
+ */
+import { existsSync } from 'node:fs';
+import { mkdir, writeFile } from 'node:fs/promises';
+import { homedir } from 'node:os';
+import { join } from 'node:path';
+import { getArchonHome } from '@archon/paths';
+import type { Project } from './types';
+
+export function companyDataDir(): string {
+  const configured = process.env.COMPANY_DATA_DIR;
+  return configured ? configured.replace(/^~(?=$|\/)/, homedir()) : join(getArchonHome(), 'company');
+}
+
+export function projectDir(projectId: string): string {
+  return join(companyDataDir(), 'projects', projectId);
+}
+
+export interface GitResult {
+  code: number;
+  stdout: string;
+  stderr: string;
+}
+
+export async function git(cwd: string, args: string[], env: Record<string, string> = {}): Promise<GitResult> {
+  const proc = Bun.spawn(['git', ...args], {
+    cwd,
+    env: { ...process.env, GIT_TERMINAL_PROMPT: '0', ...env },
+    stdin: 'ignore',
+    stdout: 'pipe',
+    stderr: 'pipe',
+  });
+  const [stdout, stderr, code] = await Promise.all([
+    new Response(proc.stdout).text(),
+    new Response(proc.stderr).text(),
+    proc.exited,
+  ]);
+  return { code, stdout: stdout.trim(), stderr: stderr.trim() };
+}
+
+async function gitOk(cwd: string, args: string[]): Promise<string> {
+  const result = await git(cwd, args);
+  if (result.code !== 0) throw new Error(`git ${args.join(' ')} failed in ${cwd}: ${result.stderr || result.stdout}`);
+  return result.stdout;
+}
+
+const COMMIT_ENV = {
+  GIT_AUTHOR_NAME: 'AI Company',
+  GIT_AUTHOR_EMAIL: 'ai-company@localhost',
+  GIT_COMMITTER_NAME: 'AI Company',
+  GIT_COMMITTER_EMAIL: 'ai-company@localhost',
+};
+
+/**
+ * Make sure the project has a working checkout with an `origin`. A project with a
+ * repository URL is cloned; one without gets a bare origin beside its checkout so
+ * Archon's worktree isolation (which needs a remote) and branch integration work.
+ */
+export async function ensureProjectRepo(project: Project): Promise<{ repoPath: string; originUrl: string; defaultBranch: string }> {
+  const dir = projectDir(project.id);
+  const repoPath = join(dir, 'repo');
+  await mkdir(dir, { recursive: true });
+  if (project.repository_url) {
+    if (!existsSync(join(repoPath, '.git'))) {
+      await gitOk(dir, ['clone', project.repository_url, 'repo']);
+    }
+    const branch = (await git(repoPath, ['rev-parse', '--abbrev-ref', 'HEAD'])).stdout || project.default_branch;
+    return { repoPath, originUrl: project.repository_url, defaultBranch: branch };
+  }
+  const originPath = join(dir, 'origin.git');
+  if (!existsSync(originPath)) await gitOk(dir, ['init', '--bare', '-b', project.default_branch, 'origin.git']);
+  if (!existsSync(join(repoPath, '.git'))) {
+    await gitOk(dir, ['init', '-b', project.default_branch, 'repo']);
+    await writeFile(
+      join(repoPath, 'README.md'),
+      `# ${project.name}\n\n${project.description}\n\nThis repository is developed autonomously by an AI software company built on Archon.\n`
+    );
+    await writeFile(join(repoPath, '.gitignore'), 'node_modules/\n.env\ndist/\n__pycache__/\n*.pyc\n.venv/\ntarget/\n');
+    const result = await git(repoPath, ['add', '-A']);
+    if (result.code !== 0) throw new Error(result.stderr);
+    const commit = await git(repoPath, ['commit', '-m', 'chore: initialise project repository'], COMMIT_ENV);
+    if (commit.code !== 0) throw new Error(commit.stderr);
+    await gitOk(repoPath, ['remote', 'add', 'origin', originPath]);
+    await gitOk(repoPath, ['push', '-u', 'origin', project.default_branch]);
+  }
+  return { repoPath, originUrl: originPath, defaultBranch: project.default_branch };
+}
+
+export interface IntegrationResult {
+  merged: boolean;
+  head: string | null;
+  conflict: boolean;
+  detail: string;
+}
+
+/** Merge a pushed task branch into the integration branch and push it. Conflicts abort cleanly. */
+export async function integrateBranch(project: Project, branch: string, message: string): Promise<IntegrationResult> {
+  const repoPath = project.repo_path;
+  if (!repoPath) return { merged: false, head: null, conflict: false, detail: 'project has no checkout' };
+  const target = project.default_branch;
+  await gitOk(repoPath, ['fetch', 'origin', '--prune']);
+  await gitOk(repoPath, ['checkout', '-q', target]);
+  const ff = await git(repoPath, ['merge', '--ff-only', `origin/${target}`]);
+  if (ff.code !== 0) return { merged: false, head: null, conflict: false, detail: `integration checkout diverged from origin/${target}: ${ff.stderr}` };
+  const remoteBranch = `origin/${branch}`;
+  const exists = await git(repoPath, ['rev-parse', '--verify', '--quiet', remoteBranch]);
+  if (exists.code !== 0) return { merged: false, head: null, conflict: false, detail: `branch ${branch} was not pushed to origin` };
+  const merge = await git(repoPath, ['merge', '--no-ff', '--no-edit', '-m', message, remoteBranch], COMMIT_ENV);
+  if (merge.code !== 0) {
+    const conflicts = (await git(repoPath, ['diff', '--name-only', '--diff-filter=U'])).stdout;
+    await git(repoPath, ['merge', '--abort']);
+    return { merged: false, head: null, conflict: true, detail: conflicts ? `conflicts in: ${conflicts.split('\n').join(', ')}` : merge.stderr };
+  }
+  const push = await git(repoPath, ['push', 'origin', target]);
+  if (push.code !== 0) {
+    await git(repoPath, ['reset', '--hard', `origin/${target}`]);
+    return { merged: false, head: null, conflict: false, detail: `push rejected: ${push.stderr}` };
+  }
+  const head = (await git(repoPath, ['rev-parse', 'HEAD'])).stdout;
+  return { merged: true, head, conflict: false, detail: `merged ${branch} into ${target} at ${head.slice(0, 8)}` };
+}
+
+/** Bring the integration checkout to origin's default branch (used before staging deploys). */
+export async function syncCheckout(project: Project): Promise<string | null> {
+  if (!project.repo_path) return null;
+  await gitOk(project.repo_path, ['fetch', 'origin', '--prune']);
+  await gitOk(project.repo_path, ['checkout', '-q', project.default_branch]);
+  const ff = await git(project.repo_path, ['merge', '--ff-only', `origin/${project.default_branch}`]);
+  if (ff.code !== 0) throw new Error(`cannot fast-forward ${project.default_branch}: ${ff.stderr}`);
+  return (await git(project.repo_path, ['rev-parse', 'HEAD'])).stdout;
+}
