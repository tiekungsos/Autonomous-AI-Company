+        <ul className="space-y-1">{(engines?.engines ?? []).map(e => <li key={e.id} className="flex items-center gap-3 text-[12px]"><StatusPill status={e.available ? 'available' : 'unavailable'} /><strong className="text-text-primary">{e.id}</strong><span className="text-text-secondary">{e.displayName}</span><span className="font-mono text-[10px] text-text-tertiary">{e.reason}</span></li>)}</ul>
