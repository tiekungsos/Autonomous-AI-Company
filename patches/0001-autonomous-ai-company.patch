+  documents: { kind: string; path: string }[];
+}
+
+let limits: CompanyLimits = readLimits();
+let ticking = false;
+let timer: ReturnType<typeof setInterval> | null = null;
+/** When this server process started: a run dispatched before it, still "running" with no answering owner, was orphaned by the restart. */
+const bootedAt = Date.now();
+let operations: ReturnType<typeof createSqlWorkflowOperations> | null = null;
+function workflowOperations(): ReturnType<typeof createSqlWorkflowOperations> {
+  operations ??= createSqlWorkflowOperations();
