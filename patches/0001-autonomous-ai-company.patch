+      <td className="py-1.5 pr-3 font-mono text-[11px] text-text-tertiary">{execution.tokens_in !== null ? `${String(execution.tokens_in)}/${String(execution.tokens_out ?? 0)} tok` : ''}{execution.cost_usd !== null ? ` ${money(execution.cost_usd)}` : execution.cost_estimated_usd !== null ? ` ~${money(execution.cost_estimated_usd)}` : ''}</td>
+      <td className="py-1.5 pr-3"><RunLink runId={execution.run_id} projectCodebaseId={codebaseId} /></td>
+      <td className="py-1.5 text-[12px] text-text-secondary">{execution.summary ?? execution.error ?? ''}</td>
