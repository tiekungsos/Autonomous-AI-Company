+++ b/packages/server/src/company/engines.ts
@@ -0,0 +1,233 @@
+/**
+ * Role profiles and coding-engine selection. Roles are configuration
+ * (`agents/roles.yaml`); engines are Archon's registered providers. Nothing here
+ * stores credentials: availability is whatever each provider's own
+ * `checkCredential` reports.
+ */
+import { readFileSync, statSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { resolve } from 'node:path';
+import { getAgentProvider, getRegisteredProviders } from '@archon/providers';
+import { parse as parseYaml } from 'yaml';
+import type { Engine } from './types';
+
+export interface RoleProfile {
+  id: string;
+  title: string;
+  alias: string;
+  engine: string;
+  model: string;
+  models: Record<string, string>;
+  instructions?: string;
+  responsibilities?: string[];
+  timeout_minutes?: number;
+  max_tokens?: number;
+}
+
+export interface RolesConfig {
+  defaults: { timeout_minutes: number; max_tokens: number; fallback: string[] };
+  roles: Record<string, RoleProfile>;
+  tiers: Record<string, { small: string; medium: string; large: string }>;
+}
+
+const DEFAULT_ROLES_PATH = resolve(import.meta.dir, '../../../../../agents/roles.yaml');
+
+export function rolesPath(): string {
+  const configured = process.env.COMPANY_ROLES_PATH;
+  return configured ? configured.replace(/^~(?=$|\/)/, homedir()) : DEFAULT_ROLES_PATH;
+}
+
+let cached: { config: RolesConfig; path: string; mtimeMs: number } | null = null;
+
+/** Re-read when the file changed, so an operator's edit applies to the next dispatch without a restart. */
+export function loadRoles(path: string = rolesPath()): RolesConfig {
+  const mtimeMs = statSync(path).mtimeMs;
+  if (cached && cached.path === path && cached.mtimeMs === mtimeMs) return cached.config;
+  const raw = parseYaml(readFileSync(path, 'utf8')) as {
+    defaults?: Partial<RolesConfig['defaults']>;
+    roles?: Record<string, Omit<RoleProfile, 'id'>>;
+    tiers?: RolesConfig['tiers'];
+  };
+  const roles: Record<string, RoleProfile> = {};
+  for (const [id, role] of Object.entries(raw.roles ?? {})) {
+    if (!role.alias?.startsWith('@')) throw new Error(`role ${id}: alias must start with '@'`);
+    roles[id] = { ...role, id, models: role.models ?? { [role.engine]: role.model } };
+  }
+  const config: RolesConfig = {
+    defaults: {
+      timeout_minutes: raw.defaults?.timeout_minutes ?? 60,
+      max_tokens: raw.defaults?.max_tokens ?? 400_000,
+      fallback: raw.defaults?.fallback ?? ['devin', 'claude', 'codex', 'pi'],
+    },
+    roles,
+    tiers: raw.tiers ?? {},
+  };
+  cached = { config, path, mtimeMs };
+  return config;
+}
+
+export function resetRolesCache(): void {
+  cached = null;
+}
+
+/** A task role such as `developer-frontend` maps to the `developer` profile. */
+export function roleProfile(roleId: string, config: RolesConfig = loadRoles()): RoleProfile {
+  const direct = config.roles[roleId];
+  if (direct) return direct;
+  const base = roleId.split('-')[0];
+  const fallback = config.roles[base];
+  if (fallback) return fallback;
+  throw new Error(`unknown role '${roleId}'`);
+}
+
+/**
+ * `COMPANY_MODEL_OVERRIDE=<engine>/<model>` (e.g. `devin/swe-2-high`) binds every role,
+ * every tier and every task size to one model: a cheap test mode. Unset to restore
+ * the per-role and per-size mapping from roles.yaml.
+ */
+export function modelOverride(env: NodeJS.ProcessEnv = process.env): { engine: string; model: string } | null {
+  const raw = env.COMPANY_MODEL_OVERRIDE?.trim();
+  if (!raw) return null;
+  const slash = raw.indexOf('/');
+  if (slash <= 0 || slash === raw.length - 1) throw new Error(`COMPANY_MODEL_OVERRIDE must be <engine>/<model>, got '${raw}'`);
+  return { engine: raw.slice(0, slash), model: raw.slice(slash + 1) };
+}
+
+export interface EngineStatus {
+  id: string;
+  displayName: string;
+  available: boolean;
+  reason: string;
+}
+
+const STATUS_TTL_MS = 120_000;
+let statusCache: { at: number; value: EngineStatus[] } | null = null;
+
+/** Registered providers and whether each can authenticate right now (cached two minutes). */
+export async function engineStatuses(force = false): Promise<EngineStatus[]> {
+  if (!force && statusCache && Date.now() - statusCache.at < STATUS_TTL_MS) return statusCache.value;
+  const env = Object.fromEntries(
+    Object.entries(process.env).filter((entry): entry is [string, string] => entry[1] !== undefined)
+  );
+  const statuses = await Promise.all(
+    getRegisteredProviders()
+      .filter(registration => registration.deprecationNotice === undefined)
+      .map(async (registration): Promise<EngineStatus> => {
+        const base = { id: registration.id, displayName: registration.displayName };
+        try {
+          const provider = getAgentProvider(registration.id);
+          const status = await provider.checkCredential({ env, signal: AbortSignal.timeout(20_000) });
+          // Only a credential the runtime itself verified counts as available (not_checked is shown, never auto-selected).
+          const available = status.state === 'usable';
+          const reason =
+            status.state === 'usable'
+              ? 'credential usable'
+              : status.state === 'not_checked'
+                ? 'credential not checked by provider'
+                : 'evidence' in status
+                  ? `${status.state}: ${status.evidence}`
+                  : status.state;
+          return { ...base, available, reason };
+        } catch (error) {
+          return { ...base, available: false, reason: `check failed: ${(error as Error).message}` };
+        }
+      })
+  );
+  statusCache = { at: Date.now(), value: statuses };
+  return statuses;
+}
+
+/** Tests and the "refresh engines" action bypass the cache. */
+export function resetEngineStatusCache(): void {
+  statusCache = null;
+}
+
+export class NoEngineAvailableError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'NoEngineAvailableError';
+  }
+}
+
+/**
+ * Pick the engine for a role: an explicit project/task engine when available,
+ * otherwise the role's preferred engine, otherwise the configured fallback order.
+ */
+export function selectEngine(
+  preferred: Engine | string | null | undefined,
+  role: RoleProfile,
+  statuses: EngineStatus[],
+  config: RolesConfig = loadRoles()
+): string {
+  const usable = new Set(statuses.filter(status => status.available).map(status => status.id));
+  const override = modelOverride();
+  if (override) {
+    if (usable.has(override.engine)) return override.engine;
+    throw new NoEngineAvailableError(`COMPANY_MODEL_OVERRIDE engine '${override.engine}' is not available`);
+  }
+  if (preferred && preferred !== 'auto') {
+    if (usable.has(preferred)) return preferred;
+    throw new NoEngineAvailableError(
+      `engine '${preferred}' is not available: ${statuses.find(s => s.id === preferred)?.reason ?? 'not registered'}`
+    );
+  }
+  const order = [role.engine, ...config.defaults.fallback];
+  const chosen = order.find(id => usable.has(id) && (role.models[id] !== undefined || config.tiers[id] !== undefined));
+  if (!chosen) {
+    throw new NoEngineAvailableError(
+      `no available engine for role ${role.id}; tried ${order.join(', ')} (${statuses.map(s => `${s.id}: ${s.reason}`).join('; ')})`
+    );
+  }
+  return chosen;
+}
+
+/**
+ * Whether a role's own engine may be used: its credential verified, or the operator chose it
+ * explicitly and the provider cannot check without spending (Claude reports `not_checked`).
+ */
+export function roleEngineSelectable(engineId: string, statuses: EngineStatus[]): boolean {
+  const status = statuses.find(s => s.id === engineId);
+  return status !== undefined && (status.available || status.reason === 'credential not checked by provider');
+}
+
+/**
+ * The run-level `tiers` and `aliases`: tiers bind the chosen run engine (with a task `size`,
+ * the `large` tier that `archon-implement` runs on becomes that size's model); each role alias
+ * binds the role's own engine and model when that engine is selectable, else the run engine.
+ */
+export function roleBindings(
+  engine: string,
+  config: RolesConfig = loadRoles(),
+  size?: 'small' | 'medium' | 'large',
+  statuses: EngineStatus[] = []
+): {
+  tiers: { small: string; medium: string; large: string };
+  aliases: Record<string, string>;
+} {
+  const override = modelOverride();
+  if (override) {
+    const spec = `${override.engine}/${override.model}`;
+    return {
+      tiers: { small: spec, medium: spec, large: spec },
+      aliases: Object.fromEntries(Object.values(config.roles).map(role => [role.alias, spec])),
+    };
+  }
+  const configured = config.tiers[engine];
+  if (!configured) throw new Error(`no model tiers configured for engine '${engine}' in roles.yaml`);
+  const tiers = size ? { ...configured, large: configured[size] } : configured;
+  const aliases: Record<string, string> = {};
+  for (const role of Object.values(config.roles)) {
+    const own = role.engine !== engine && roleEngineSelectable(role.engine, statuses) && role.models[role.engine] !== undefined;
+    const roleEngine = own ? role.engine : engine;
+    const model = role.models[roleEngine] ?? (roleEngine === engine ? tiers.large : role.model);
+    aliases[role.alias] = `${roleEngine}/${model}`;
+  }
+  return {
+    tiers: {
+      small: `${engine}/${tiers.small}`,
+      medium: `${engine}/${tiers.medium}`,
+      large: `${engine}/${tiers.large}`,
+    },
+    aliases,
+  };
+}
