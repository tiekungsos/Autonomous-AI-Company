+    }
+    return { observed: open.length, projects: projects.length };
+  } finally {
+    ticking = false;
+  }
+}
+
+/* --------------------------------- observation -------------------------------- */
+
+async function observeExecution(execution: Execution): Promise<void> {
+  let runId = execution.run_id;
+  if (!runId && execution.conversation_id) {
+    runId = await findRunForConversation(execution.conversation_id);
+    if (runId) await db.updateExecution(execution.id, { run_id: runId, status: 'running', last_seen_at: db.now() });
+  }
+  if (!runId) {
+    const ageMs = Date.now() - Date.parse(execution.started_at);
+    // The orchestrator answers a refused dispatch on the conversation instead of creating a run.
+    const outcome = ageMs > 15_000 && execution.conversation_id ? await dispatchOutcome(execution.conversation_id) : null;
+    if (outcome?.kind === 'run') {
+      await db.updateExecution(execution.id, { run_id: outcome.runId, status: 'running', last_seen_at: db.now() });
+      return;
+    }
+    if (outcome?.kind === 'refused' || ageMs > 5 * 60_000) {
+      const error = outcome?.kind === 'refused' ? `Archon refused the dispatch: ${outcome.reason.slice(0, 500)}` : 'Archon created no run for this dispatch within 5 minutes';
+      await db.updateExecution(execution.id, { status: 'failed', error, finished_at: db.now() });
+      await db.addEvent({ project_id: execution.project_id, execution_id: execution.id, task_id: execution.task_id, level: 'error', kind: 'execution.lost', message: `${execution.workflow_name}: ${error}` });
+      await onExecutionFinished({ ...execution, status: 'failed', error }, null, null);
+    }
+    return;
+  }
+  let run = await readRun(runId);
+  if (!run) {
+    await db.updateExecution(execution.id, { status: 'failed', error: 'run row disappeared', finished_at: db.now() });
+    await onExecutionFinished({ ...execution, status: 'failed' }, null, null);
+    return;
+  }
+  let terminal = run.status === 'completed' || run.status === 'failed' || run.status === 'cancelled';
+  if (!terminal && (await orphanedByRestart(execution, run))) {
+    // Restart reconciliation: the executor that owned this run died with the previous server
+    // process. Abandon it (Archon cancels the run and releases its worktree), then let the
+    // normal failure path retry the work within its limits.
+    try {
+      await workflowOperations().abandonWorkflow(run.id, { kind: 'operator' });
+    } catch (error) {
+      log.warn({ err: error, runId: run.id }, 'company.orphan_abandon_failed');
+    }
+    await db.addEvent({ project_id: execution.project_id, execution_id: execution.id, task_id: execution.task_id, level: 'warn', kind: 'execution.orphaned', message: `Run ${run.id} was orphaned by a server restart and abandoned; the work will be retried` });
+    // A restart is not the task's failure: the lost attempt does not count against its retry
+    // limit, and the task keeps the verdict of its last real attempt (which may name the run
+    // a retry adopts).
+    if (execution.task_id) {
+      const task = await db.getTask(execution.task_id);
+      if (task) {
+        await db.updateExecution(execution.id, { status: 'failed', error: 'run orphaned by a server restart', finished_at: db.now() });
+        await db.updateTask(task.id, { attempt_base: task.attempt_base + 1, status: 'READY' });
+        return;
+      }
+    }
+    const refreshed = await readRun(run.id);
+    if (refreshed && (refreshed.status === 'completed' || refreshed.status === 'failed' || refreshed.status === 'cancelled')) {
+      run = refreshed;
+      terminal = true;
+    } else {
+      await db.updateExecution(execution.id, { status: 'failed', error: 'run orphaned by a server restart', finished_at: db.now() });
+      await onExecutionFinished({ ...execution, run_id: run.id, status: 'failed', error: 'run orphaned by a server restart' }, run, null);
+      return;
+    }
+  }
+  if (!terminal) {
+    const lastActivity = run.last_activity_at ? new Date(run.last_activity_at).getTime() : new Date(run.started_at).getTime();
+    const stale = run.status === 'running' && Date.now() - lastActivity > limits.maxAgentExecutionMinutes * 60_000;
+    const nextStatus = stale ? 'stale' : 'running';
+    if (execution.status !== nextStatus || !execution.run_id) {
+      await db.updateExecution(execution.id, { run_id: runId, status: nextStatus, last_seen_at: db.now() });
+      if (stale) await db.addEvent({ project_id: execution.project_id, execution_id: execution.id, task_id: execution.task_id, level: 'warn', kind: 'execution.stale', message: `Run ${runId} has had no activity for ${String(limits.maxAgentExecutionMinutes)} minutes` });
+    } else {
+      await db.updateExecution(execution.id, { last_seen_at: db.now() });
+    }
+    if (execution.phase === 'intake') await reflectIntakeProgress(execution, run);
+    return;
+  }
+  const events = await workflowEventDb.listWorkflowEvents(runId);
+  const record = getTerminalRecord(run.status, events);
+  const value = record?.returns.availability === 'available' && typeof record.returns.value === 'object' && record.returns.value !== null
+    ? (record.returns.value as Json)
+    : null;
+  const metadata = run.metadata as Json;
+  const tokensIn = numberOr(metadata.total_tokens_in);
+  const tokensOut = numberOr(metadata.total_tokens_out);
+  const measuredCost = numberOr(metadata.total_cost_usd) ?? numberOr(metadata.total_cost);
+  const estimatedCost = measuredCost === null ? estimateCost(execution.engine, execution.role, metadata, tokensIn, tokensOut) : null;
+  const succeeded = run.status === 'completed' && run.outcome !== 'failed';
+  const error = typeof metadata.error === 'string' ? metadata.error : run.status === 'cancelled' ? 'run cancelled' : null;
+  const finished: Execution = {
+    ...execution,
+    run_id: runId,
+    status: run.status === 'cancelled' ? 'cancelled' : succeeded ? 'completed' : 'failed',
+    verdict: run.outcome ?? null,
+    summary: typeof value?.summary === 'string' ? value.summary : null,
+    error,
+    tokens_in: tokensIn,
+    tokens_out: tokensOut,
+    cost_usd: measuredCost,
+    cost_estimated_usd: estimatedCost,
+    finished_at: db.now(),
+    last_seen_at: db.now(),
+  };
+  await db.updateExecution(execution.id, finished);
+  await db.addEvent({
+    project_id: execution.project_id,
+    execution_id: execution.id,
+    task_id: execution.task_id,
+    level: finished.status === 'completed' ? 'info' : 'warn',
+    kind: `execution.${finished.status}`,
+    message: `${execution.workflow_name} (${execution.role} on ${execution.engine}) ${finished.status}${finished.summary ? `: ${finished.summary}` : ''}${error ? ` — ${error}` : ''}`,
+    data: { runId, outcome: run.outcome, value },
+  });
+  await onExecutionFinished(finished, run, value);
+}
+
+/**
+ * A run dispatched before this process started, still reported running, whose live-owner
+ * endpoint nobody answers: the previous server died with it. A run this process dispatched
+ * is never judged this way, so the window between claim and endpoint publication cannot
+ * misfire; Archon's own ownership rule (never guess a live owner) is honoured by asking it.
+ */
+async function orphanedByRestart(execution: Execution, run: Run): Promise<boolean> {
+  if (run.status !== 'running') return false;
+  if (Date.parse(execution.started_at) >= bootedAt) return false;
+  if (Date.now() - bootedAt < 30_000) return false;
+  return !(await isRunOwnerAnswering(run.id));
+}
+
+function numberOr(value: unknown): number | null {
+  return typeof value === 'number' && Number.isFinite(value) ? value : null;
+}
+
+/**
+ * Tokens times the published list price of the model the execution's role was bound to
+ * (its alias in the run's effective bindings, else the `large` tier). An estimate, never a
+ * bill: a run mixes roles and the usage is reported per run, not per node.
+ */
+function estimateCost(engine: string, roleId: string, metadata: Json, tokensIn: number | null, tokensOut: number | null): number | null {
+  if (engine !== 'devin' || tokensIn === null || tokensOut === null) return null;
+  const bindings = metadata.model_bindings as { effective?: { aliases?: Record<string, { model?: string }> } } | undefined;
+  let alias: string | undefined;
+  try {
+    alias = roleProfile(roleId).alias;
+  } catch {
+    alias = undefined;
+  }
+  const model = (alias ? bindings?.effective?.aliases?.[alias]?.model : undefined) ?? bindings?.effective?.aliases?.large?.model ?? '';
+  const normalized = model.replace(/-/g, '.');
+  const family = Object.keys(DEVIN_PRICES)
+    .sort((a, b) => b.length - a.length)
+    .find(prefix => normalized.startsWith(prefix.replace(/-/g, '.')));
+  if (!family) return null;
+  const price = DEVIN_PRICES[family];
+  return (tokensIn * price.input + tokensOut * price.output) / 1_000_000;
+}
+
+async function reflectIntakeProgress(execution: Execution, run: Run): Promise<void> {
+  const events = await workflowEventDb.listWorkflowEvents(run.id);
+  const states = buildRunNodeStates(run, events);
+  const running = states.filter(s => s.state === 'running').map(s => s.node_id);
+  const active = running[running.length - 1] ?? [...states].reverse().find(s => s.state === 'completed')?.node_id;
+  const phase = active ? INTAKE_NODE_PHASE[active] : undefined;
+  const project = await db.getProject(execution.project_id);
+  if (phase && project && project.phase !== phase && !TERMINAL_PHASES.has(project.phase)) {
+    await db.updateProject(project.id, { phase });
+  }
+}
+
+/* ------------------------------- phase handlers ------------------------------- */
+
+async function advanceProject(project: Project): Promise<void> {
+  const open = (await db.listExecutions(project.id, 50)).filter(e => e.status === 'dispatched' || e.status === 'running' || e.status === 'stale');
+  switch (project.phase) {
+    case 'PROJECT_CREATED':
+      await startIntake(project);
+      return;
+    case 'REQUIREMENTS_ANALYSIS':
+    case 'SRS_GENERATION':
+    case 'ARCHITECTURE_DESIGN':
+    case 'DEVELOPMENT_PLANNING':
+    case 'TASK_BREAKDOWN':
+      if (open.length === 0) {
+        const entered = Date.parse(project.phase_entered_at ?? project.updated_at);
+        const sinceEntry = (await db.listExecutions(project.id, 20)).filter(e => e.phase === 'intake' && Date.parse(e.started_at) >= entered - 1000);
+        if (sinceEntry.length === 0 && Date.now() - entered > 120_000) {
+          await db.updateProject(project.id, { phase: 'BLOCKED', blocked_reason: 'Intake is not running (the dispatch was lost); press Resume to run it again.' });
+        }
+      }
+      return;
+    case 'AUTONOMOUS_DEVELOPMENT':
+      await scheduleTasks(project, open.filter(e => e.phase === 'task').length);
+      return;
+    case 'INTEGRATION':
+      await finishIntegration(project);
+      return;
+    case 'AUTOMATED_QA':
+      if (open.length === 0 && !(await hasExecution(project, 'qa'))) await startGate(project, 'qa');
+      return;
+    case 'SECURITY_REVIEW':
+      if (open.length === 0 && !(await hasExecution(project, 'security'))) await startSecurityReview(project);
+      return;
+    case 'STAGING_DEPLOYMENT':
+      if (open.length === 0 && !(await hasExecution(project, 'deploy'))) await startDeploy(project);
+      return;
+    case 'ACCEPTANCE_VERIFICATION':
+      if (open.length === 0 && !(await hasExecution(project, 'acceptance'))) await startGate(project, 'acceptance');
+      return;
+    case 'DELIVERY':
+      if (open.length === 0 && !(await hasExecution(project, 'delivery'))) await startDelivery(project);
+      return;
+    default:
+      return;
+  }
+}
+
+/** Whether a dispatch for this phase already exists since the project entered its current phase (idempotency). */
+async function hasExecution(project: Project, phase: string): Promise<boolean> {
+  const key = roundKey(project, phase);
+  return (await db.listExecutions(project.id, 200)).some(e => e.idempotency_key === key);
+}
+
+/**
+ * One dispatch per phase entry: the key carries the time the project entered the phase,
+ * which `updateProject` restamps on every phase change (repairs, resume). Durable across
+ * restarts, unlike an in-memory round counter.
+ */
+function roundKey(project: Project, phase: string): string {
+  return `project:${project.id}:${phase}:entered:${project.phase_entered_at ?? project.updated_at}`;
+}
+
+async function dispatch(
+  project: Project,
+  phase: string,
+  roleId: string,
+  workflowName: string,
+  message: string,
+  inputs: Record<string, string>,
+  options: { task?: Task; idempotencyKey: string; engine?: string | null; size?: TaskSize; adoptRunId?: string }
+): Promise<Execution | null> {
+  if (!project.codebase_id) throw new Error('project has no registered codebase');
+  const spend = await db.projectSpend(project.id);
+  if (project.budget_usd !== null && spend.measured + spend.estimated >= project.budget_usd) {
+    await db.updateProject(project.id, { paused: 1, blocked_reason: `Budget exhausted: spent ${(spend.measured + spend.estimated).toFixed(2)} of ${String(project.budget_usd)} USD (measured + estimated)` });
+    await db.addEvent({ project_id: project.id, level: 'warn', kind: 'budget.exhausted', message: 'Project paused: budget limit reached. Raise the budget and resume.' });
+    return null;
+  }
+  const role = roleProfile(roleId);
+  const statuses = await engineStatuses();
+  let engine: string;
+  try {
+    engine = selectEngine(options.engine ?? project.engine, role, statuses);
+  } catch (error) {
+    if (error instanceof NoEngineAvailableError) {
+      await db.updateProject(project.id, { last_error: error.message });
+      await db.addEvent({ project_id: project.id, task_id: options.task?.id, level: 'error', kind: 'engine.unavailable', message: error.message });
+      return null;
+    }
+    throw error;
+  }
+  const execution = await db.insertExecution({
+    idempotency_key: options.idempotencyKey,
+    project_id: project.id,
+    task_id: options.task?.id ?? null,
+    phase,
+    role: role.id,
+    engine,
+    workflow_name: workflowName,
+  });
+  if (!execution) {
+    log.warn({ projectId: project.id, key: options.idempotencyKey }, 'company.dispatch_already_recorded');
+    return null;
+  }
+  const bindings = roleBindings(engine, undefined, options.size, statuses);
+  try {
+    const result = await dispatchWorkflow({
+      codebaseId: project.codebase_id,
+      workflowName,
+      message,
+      inputs,
+      tiers: bindings.tiers,
+      aliases: bindings.aliases,
+      ...(options.adoptRunId ? { adoptRunId: options.adoptRunId } : {}),
+      onError: async error => {
+        await db.updateExecution(execution.id, { status: 'failed', error: error.message, finished_at: db.now() });
+        await db.addEvent({ project_id: project.id, execution_id: execution.id, task_id: options.task?.id, level: 'error', kind: 'execution.dispatch_failed', message: error.message });
+      },
+    });
+    await db.updateExecution(execution.id, { conversation_id: result.conversationDbId, status: 'dispatched', last_seen_at: db.now() });
+    await db.addEvent({ project_id: project.id, task_id: options.task?.id, execution_id: execution.id, kind: 'execution.dispatched', message: `${workflowName} dispatched for ${role.title} on ${engine}`, data: { conversationId: result.conversationId } });
+    return (await db.getExecution(execution.id)) ?? execution;
+  } catch (error) {
+    await db.updateExecution(execution.id, { status: 'failed', error: (error as Error).message, finished_at: db.now() });
+    await db.addEvent({ project_id: project.id, execution_id: execution.id, level: 'error', kind: 'execution.dispatch_failed', message: (error as Error).message });
+    return null;
+  }
+}
+
+async function startIntake(project: Project): Promise<void> {
+  const prepared = await prepareProject(project);
+  const execution = await dispatch(
+    prepared,
+    'intake',
+    'ceo',
+    'company-project-intake',
+    `Intake for project "${prepared.name}"`,
+    {
+      project_name: prepared.name,
+      description: prepared.description,
+      requirements: prepared.requirements,
+      tech_stack: prepared.tech_stack ?? '',
+      repository_url: prepared.repository_url ?? '',
+    },
+    { idempotencyKey: roundKey(prepared, 'intake') }
+  );
+  if (execution) await db.updateProject(prepared.id, { phase: 'REQUIREMENTS_ANALYSIS', last_error: null });
+}
+
+/** Make sure the project has a checkout, an origin and an Archon codebase registration. */
+async function prepareProject(project: Project): Promise<Project> {
+  if (project.codebase_id && project.repo_path) return project;
+  const repo = await ensureProjectRepo(project);
+  let codebaseId = project.codebase_id;
+  if (!codebaseId) {
+    const registration = await registerRepository(repo.repoPath, { baseBranch: repo.defaultBranch });
+    codebaseId = registration.codebaseId;
+  }
+  const updated = await db.updateProject(project.id, { codebase_id: codebaseId, repo_path: repo.repoPath, origin_url: repo.originUrl, default_branch: repo.defaultBranch });
+  await db.addEvent({ project_id: project.id, kind: 'project.prepared', message: `Repository ready at ${repo.repoPath} (origin ${repo.originUrl}); registered as Archon codebase ${codebaseId}` });
+  return updated as Project;
+}
+
+async function scheduleTasks(project: Project, openTaskRuns: number): Promise<void> {
+  const tasks = await db.listTasks(project.id);
+  const deps = await db.listTaskDependencies(project.id);
+  const byId = new Map(tasks.map(t => [t.id, t]));
+  const blockersOf = (task: Task): (Task | undefined)[] => deps.filter(d => d.task_id === task.id).map(d => byId.get(d.depends_on_task_id));
+  for (const task of tasks.filter(t => t.status === 'BACKLOG')) {
+    const blockers = blockersOf(task);
+    if (blockers.every(b => b?.status === 'COMPLETED')) await db.updateTask(task.id, { status: 'READY' });
+    else if (blockers.some(b => b?.status === 'BLOCKED' || b?.status === 'CANCELLED')) {
+      await db.updateTask(task.id, { status: 'BLOCKED', last_error: 'a dependency is blocked' });
+    }
+  }
+  // Dependencies are checked again right before dispatch: a resume or an operator edit can
+  // leave a task READY while something it depends on is still open.
+  for (const task of tasks.filter(t => t.status === 'READY')) {
+    if (!blockersOf(task).every(b => b?.status === 'COMPLETED')) await db.updateTask(task.id, { status: 'BACKLOG' });
+  }
+  const refreshed = await db.listTasks(project.id);
+  const openTasks = refreshed.filter(t => OPEN_TASK_STATUSES.has(t.status));
+  if (openTasks.length === 0) {
+    const blocked = refreshed.filter(t => t.status === 'BLOCKED' || t.status === 'FAILED');
+    if (blocked.length > 0) {
+      await db.updateProject(project.id, { phase: 'BLOCKED', blocked_reason: `Blocked tasks: ${blocked.map(t => `${t.key} (${t.last_error ?? t.last_verdict ?? 'failed'})`).join('; ')}` });
+      await db.addEvent({ project_id: project.id, level: 'error', kind: 'project.blocked', message: `${String(blocked.length)} task(s) could not be completed` });
+    } else {
+      await db.updateProject(project.id, { phase: 'INTEGRATION' });
+    }
+    return;
+  }
+  const globalOpen = await db.countOpenExecutions();
+  let capacity = Math.min(limits.maxConcurrentAgents - globalOpen, project.max_concurrency - openTaskRuns);
+  const ready = refreshed.filter(t => t.status === 'READY').sort((a, b) => a.priority - b.priority || a.created_at.localeCompare(b.created_at));
+  for (const task of ready) {
+    if (capacity <= 0) break;
+    if (task.attempts - task.attempt_base >= limits.maxTaskRetries) {
+      await db.updateTask(task.id, { status: 'BLOCKED', last_error: `exhausted ${String(limits.maxTaskRetries)} attempts` });
+      continue;
+    }
+    const attempt = task.attempts + 1;
+    // A retry after a red validation or review continues the previous run's branch instead of
+    // starting over: the commits were good enough to reach that stage and the findings name
+    // what to change. Any other failure (or a refused adoption) starts fresh from the base.
+    const adoptRunId = task.run_id && /^red at (validate|review)$/.test(task.last_verdict ?? '') ? task.run_id : undefined;
+    const brief = await taskBrief(project, task, refreshed, adoptRunId !== undefined);
+    // When the adopted run was reviewed, hand its report to this round's review so it verifies
+    // the prior findings and reviews only the correction delta (archon-review-block `prior_report`).
+    let priorReport = '';
+    if (adoptRunId) {
+      const previous = await readRun(adoptRunId);
+      const dir = previous ? runArtifactsDir(previous) : null;
+      if (dir && (await readRunArtifact(previous!, 'review/report.md')) !== null) priorReport = join(dir, 'review', 'report.md');
+    }
+    const execution = await dispatch(
+      project,
+      'task',
+      task.role,
+      'company-task-execution',
+      `${task.key}: ${task.title}`,
+      { task_brief: brief.brief, work_order: brief.workOrder, project_commands: brief.commands, prior_report: priorReport },
+      { task: task, idempotencyKey: `task:${task.id}:attempt:${String(attempt)}`, engine: task.engine, size: task.size as TaskSize, adoptRunId }
+    );
+    if (execution) {
+      // run_id keeps naming the last finished attempt until this one finishes: a retry after a
+      // restart adopts it.
+      await db.updateTask(task.id, { status: 'RUNNING', attempts: attempt, last_error: null });
+      capacity -= 1;
+    } else {
+      break;
+    }
+  }
+}
+
+async function intakeDocument(project: Project): Promise<IntakeResult | null> {
+  const docs = await db.listDocuments(project.id);
+  const intake = docs.filter(d => d.kind === 'intake').pop();
+  if (!intake) return null;
+  try {
+    return JSON.parse(intake.content) as IntakeResult;
+  } catch {
+    return null;
+  }
+}
+
+async function taskBrief(project: Project, task: Task, all: Task[], continuing = false): Promise<{ brief: string; workOrder: string; commands: string }> {
+  const intake = await intakeDocument(project);
+  const docs = await db.listDocuments(project.id);
+  const arch = docs.find(d => d.kind === 'architecture');
+  const done = all.filter(t => t.status === 'COMPLETED').map(t => `- ${t.key}: ${t.title}`).join('\n');
+  const history = continuing
+    ? `\n\n## Continue the previous attempt\nThis checkout already holds the previous attempt's commits for this task; it reached ${task.last_verdict ?? 'review'}. Keep that work and fix only what the findings below name, then commit. The previous run's artifacts are under $ADOPTED_RUN_DIR (the review report is $ADOPTED_RUN_DIR/review/report.md when review ran).\n\nFindings: ${task.last_summary ?? ''}`
+    : task.last_summary || task.last_error
+      ? `\n\nPrevious attempt (${String(task.attempts)}): ${task.last_verdict ?? ''} ${task.last_summary ?? ''} ${task.last_error ?? ''}`.trim()
+      : '';
+  const brief = [
+    `# Task ${task.key}: ${task.title}`,
+    '',
+    `Project: ${project.name}`,
+    project.description ? `\n${project.description}` : '',
+    `\n## What to build\n${task.description}`,
+    `\n## Acceptance\n${task.acceptance}`,
+    intake ? `\n## Stack and commands\n${intake.stack}\n${JSON.stringify(intake.commands)}` : '',
+    arch ? `\n## Architecture (excerpt)\n${arch.content.slice(0, 6000)}` : '',
+    done ? `\n## Already completed and merged\n${done}` : '',
+    '\n## Rules\n- Work only on this task. Keep changes small and committed (git commit before you finish).\n- Run the focused checks for what you changed; do not mark the task done while they fail.\n- Do not edit unrelated files; other agents work in parallel on other tasks.\n- You run non-interactively: never ask for permissions or access and never wait for a person.\n- Docker is available. You may build images and run containers to verify your work. Run every docker command as its own command that starts with `docker` (never chained after `cd` or `&&`; pass paths with `-f`/`--project-directory`), because only commands starting with `docker` may reach the Docker daemon. Name compose projects `t-<task key lowercase>` and run `docker compose -p <name> down -v` for anything you started before you finish.\n- Stop every server or process you start before you finish, and bind test servers to 127.0.0.1, never 0.0.0.0.\n- When an action is blocked, note it in your summary and still finish with the required structured answer.',
+    history,
+  ].join('\n');
+  const workOrder = `Deliver task ${task.key} (${task.title}). Acceptance: ${task.acceptance}`;
+  return { brief, workOrder, commands: intake ? JSON.stringify(intake.commands) : '' };
+}
+
+async function finishIntegration(project: Project): Promise<void> {
+  const head = await syncCheckout(project);
+  await db.addEvent({ project_id: project.id, kind: 'integration.synced', message: `Integration branch ${project.default_branch} at ${head ?? 'unknown'}` });
+  await db.updateProject(project.id, { phase: 'AUTOMATED_QA' });
+}
+
+async function startGate(project: Project, phase: 'qa' | 'acceptance'): Promise<void> {
+  const intake = await intakeDocument(project);
+  const deployments = await db.listDeployments(project.id);
+  const staging = deployments.find(d => d.status === 'healthy');
+  await dispatch(
+    project,
+    phase,
+    'qa_engineer',
+    'company-quality-gate',
+    phase === 'qa' ? 'Quality gate on the integrated branch' : 'Acceptance verification against staging',
+    {
+      acceptance_criteria: (intake?.acceptance_criteria ?? []).join('\n') || 'The application builds, its tests pass, and it starts.',
+      project_commands: intake ? JSON.stringify(intake.commands) : '',
+      staging_url: phase === 'acceptance' ? (staging?.url ?? '') : '',
+    },
+    { idempotencyKey: roundKey(project, phase) }
+  );
+}
+
+async function startSecurityReview(project: Project): Promise<void> {
+  await dispatch(project, 'security', 'security_engineer', 'company-security-review', 'Security review of the integrated branch', {}, { idempotencyKey: roundKey(project, 'security') });
+}
+
+async function startDeploy(project: Project): Promise<void> {
+  const intake = await intakeDocument(project);
+  if (intake && !intake.docker) {
+    await db.upsertDeployment({ project_id: project.id, compose_project: composeName(project), status: 'skipped', health: 'architecture declared no Docker deployment' });
+    await db.addEvent({ project_id: project.id, kind: 'deploy.skipped', message: 'Architecture declared no Docker deployment; staging skipped' });
+    await db.updateProject(project.id, { phase: 'ACCEPTANCE_VERIFICATION' });
+    return;
+  }
+  await syncCheckout(project);
+  await dispatch(
+    project,
+    'deploy',
+    'devops_engineer',
+    'company-staging-deploy',
+    'Deploy to isolated staging',
+    { compose_project: composeName(project), project_commands: intake ? JSON.stringify(intake.commands) : '' },
+    { idempotencyKey: roundKey(project, 'deploy') }
+  );
+}
+
+export function composeName(project: Project): string {
+  return `company-${project.id.replace(/-/g, '').slice(0, 12)}`;
+}
+
+async function startDelivery(project: Project): Promise<void> {
+  const intake = await intakeDocument(project);
+  const deployments = await db.listDeployments(project.id);
+  const executions = await db.listExecutions(project.id, 200);
+  const context = {
+    project: { name: project.name, description: project.description, stack: intake?.stack, commands: intake?.commands },
+    assumptions: intake?.assumptions ?? [],
+    acceptance_criteria: intake?.acceptance_criteria ?? [],
+    deployment: deployments.map(d => ({ status: d.status, url: d.url, compose_project: d.compose_project })),
+    executions: executions.filter(e => e.status === 'completed').map(e => ({ phase: e.phase, role: e.role, engine: e.engine, summary: e.summary })),
+  };
+  await dispatch(project, 'delivery', 'technical_writer', 'company-delivery', 'Delivery documentation', { delivery_context: JSON.stringify(context) }, { idempotencyKey: roundKey(project, 'delivery') });
+}
+
+/* ------------------------------ finished executions --------------------------- */
+
+async function onExecutionFinished(execution: Execution, run: Run | null, value: Json | null): Promise<void> {
+  const project = await db.getProject(execution.project_id);
+  if (!project || TERMINAL_PHASES.has(project.phase)) return;
+  switch (execution.phase) {
+    case 'intake':
+      return onIntakeFinished(project, execution, run, value);
+    case 'task':
+      return onTaskFinished(project, execution, value);
+    case 'qa':
+    case 'acceptance':
+      return onGateFinished(project, execution, value);
+    case 'security':
+      return onSecurityFinished(project, execution, value);
+    case 'deploy':
+      return onDeployFinished(project, execution, value);
+    case 'delivery':
+      return onDeliveryFinished(project, execution, value);
+    default:
+      return;
+  }
+}
+
+async function onIntakeFinished(project: Project, execution: Execution, run: Run | null, value: Json | null): Promise<void> {
+  if (execution.status !== 'completed' || !run || !value) {
+    await db.updateProject(project.id, { phase: 'BLOCKED', blocked_reason: `Intake did not complete: ${execution.error ?? 'no result'}` });
+    return;
+  }
+  const intake = value as unknown as IntakeResult;
+  for (const doc of intake.documents ?? []) {
+    const content = await readRunArtifact(run, doc.path);
+    if (content) await db.addDocument({ project_id: project.id, kind: doc.kind, title: doc.path, content, run_id: run.id });
+  }
+  await db.addDocument({ project_id: project.id, kind: 'intake', title: 'intake.json', content: JSON.stringify(intake, null, 2), run_id: run.id });
+  if (!intake.feasible) {
+    await db.updateProject(project.id, { phase: 'BLOCKED', blocked_reason: `CEO judged the project not feasible: ${intake.summary}` });
+    return;
+  }
+  const milestones = new Map<number, string>();
+  for (const m of intake.milestones ?? []) {
+    const row = await db.addMilestone({ project_id: project.id, seq: m.seq, title: m.title, description: m.description });
+    milestones.set(m.seq, row.id);
+  }
+  const byKey = new Map<string, Task>();
+  let priority = 0;
+  for (const t of intake.tasks ?? []) {
+    priority += 1;
+    const row = await db.addTask({ project_id: project.id, key: t.key, title: t.title, description: t.description, acceptance: t.acceptance, role: t.role || 'developer', size: t.size === 'small' || t.size === 'medium' || t.size === 'large' ? t.size : taskSizeFromEstimate(t.estimate_hours), milestone_id: milestones.get(t.milestone_seq) ?? null, priority });
+    byKey.set(t.key, row);
+  }
+  for (const t of intake.tasks ?? []) {
+    const row = byKey.get(t.key);
+    for (const dep of t.depends_on ?? []) {
+      const target = byKey.get(dep);
+      if (row && target && target.id !== row.id) await db.addTaskDependency(row.id, target.id);
+    }
+  }
+  await db.addEvent({ project_id: project.id, kind: 'intake.completed', message: `Backlog created: ${String(byKey.size)} tasks in ${String(milestones.size)} milestones. ${intake.summary}` });
+  await db.updateProject(project.id, { phase: 'AUTONOMOUS_DEVELOPMENT', last_error: null });
+}
+
+async function onTaskFinished(project: Project, execution: Execution, value: Json | null): Promise<void> {
+  if (!execution.task_id) return;
+  const task = await db.getTask(execution.task_id);
+  if (!task) return;
+  const green = execution.status === 'completed' && value?.green === true;
+  const branch = typeof value?.branch === 'string' ? value.branch : null;
+  const summary = typeof value?.summary === 'string' ? value.summary : (execution.error ?? 'no result');
+  if (!green) {
+    const retryable = task.attempts - task.attempt_base < limits.maxTaskRetries;
+    await db.updateTask(task.id, {
+      status: retryable ? 'READY' : 'BLOCKED',
+      branch,
+      run_id: execution.run_id,
+      last_verdict: typeof value?.stage === 'string' ? `red at ${value.stage}` : 'failed',
+      last_summary: summary,
+      last_error: retryable ? null : `exhausted ${String(limits.maxTaskRetries)} attempts`,
+    });
+    return;
+  }
+  await db.updateTask(task.id, { status: 'REVIEW', branch, run_id: execution.run_id, last_verdict: 'green', last_summary: summary });
+  if (!branch || value?.pushed !== true) {
+    await db.updateTask(task.id, { status: 'READY', last_error: 'branch was not pushed to origin' });
+    return;
+  }
+  const integration = await integrateBranch(project, branch, `Merge ${task.key}: ${task.title}`);
+  if (integration.merged) {
+    await db.updateTask(task.id, { status: 'COMPLETED', last_error: null });
+    await db.addEvent({ project_id: project.id, task_id: task.id, kind: 'task.integrated', message: `${task.key} ${integration.detail}` });
+    return;
+  }
+  const retryable = task.attempts - task.attempt_base < limits.maxTaskRetries;
+  await db.updateTask(task.id, {
+    status: retryable ? 'READY' : 'BLOCKED',
+    last_error: integration.conflict ? `merge conflict: ${integration.detail}` : integration.detail,
+    last_summary: `${summary}\nIntegration: ${integration.detail}. Rebase onto origin/${project.default_branch} and resolve.`,
+  });
+  await db.addEvent({ project_id: project.id, task_id: task.id, level: 'warn', kind: 'task.integration_failed', message: `${task.key}: ${integration.detail}` });
+}
+
+async function createRepairTasks(project: Project, repairs: { title: string; description: string }[], role: string): Promise<boolean> {
+  const existing = await db.listTasks(project.id);
+  const repairCount = existing.filter(t => t.kind === 'repair').length;
+  if (repairCount + repairs.length > limits.maxRepairIterations) {
+    await db.updateProject(project.id, { phase: 'BLOCKED', blocked_reason: `Repair limit reached (${String(limits.maxRepairIterations)}); latest findings: ${repairs.map(r => r.title).join('; ')}` });
+    await db.addEvent({ project_id: project.id, level: 'error', kind: 'repair.limit', message: 'Maximum repair iterations reached; project blocked for a human decision' });
+    return false;
+  }
+  let index = repairCount;
+  for (const repair of repairs) {
+    index += 1;
+    await db.addTask({ project_id: project.id, key: `R${String(index)}`, title: repair.title, description: repair.description, acceptance: 'The failing check or finding described above no longer reproduces.', role, kind: 'repair', priority: 0, status: 'READY' });
+  }
+  await db.updateProject(project.id, { phase: 'AUTONOMOUS_DEVELOPMENT' });
+  await db.addEvent({ project_id: project.id, kind: 'repair.created', message: `${String(repairs.length)} repair task(s) created; back to development` });
+  return true;
+}
+
+async function onGateFinished(project: Project, execution: Execution, value: Json | null): Promise<void> {
+  const green = execution.status === 'completed' && value?.green === true;
+  if (green) {
+    await db.updateProject(project.id, { phase: execution.phase === 'qa' ? 'SECURITY_REVIEW' : 'DELIVERY' });
+    return;
+  }
+  const repairs = Array.isArray(value?.repairs) && value.repairs.length > 0
+    ? (value.repairs as { title: string; description: string }[])
+    : [{ title: `Fix the ${execution.phase === 'qa' ? 'quality gate' : 'acceptance verification'} failure`, description: execution.error ?? 'The gate workflow did not produce a verdict.' }];
+  await createRepairTasks(project, repairs, 'developer');
+}
+
+async function onSecurityFinished(project: Project, execution: Execution, value: Json | null): Promise<void> {
+  if (execution.status !== 'completed' || !value) {
+    await createRepairTasks(project, [{ title: 'Security review did not complete', description: execution.error ?? 'no result' }], 'developer');
+    return;
+  }
+  const findings = Array.isArray(value.findings) ? (value.findings as { severity: string; title: string; file: string; fix: string }[]) : [];
+  const blocking = findings.filter(f => f.severity === 'critical' || f.severity === 'high');
+  if (value.clean === true && blocking.length === 0) {
+    await db.updateProject(project.id, { phase: 'STAGING_DEPLOYMENT' });
+    return;
+  }
+  await createRepairTasks(project, blocking.map(f => ({ title: `Security: ${f.title}`, description: `${f.file}: ${f.fix}` })), 'developer');
+}
+
+async function onDeployFinished(project: Project, execution: Execution, value: Json | null): Promise<void> {
+  const healthy = execution.status === 'completed' && value?.healthy === true;
+  await db.upsertDeployment({
+    project_id: project.id,
+    run_id: execution.run_id,
+    compose_project: composeName(project),
+    status: healthy ? 'healthy' : 'failed',
+    url: typeof value?.url === 'string' ? value.url : null,
+    health: typeof value?.summary === 'string' ? value.summary : (execution.error ?? null),
+  });
+  if (healthy) {
+    await db.updateProject(project.id, { phase: 'ACCEPTANCE_VERIFICATION' });
+    return;
+  }
+  await createRepairTasks(project, [{ title: 'Fix the staging deployment', description: String(value?.summary ?? execution.error ?? 'docker compose did not become healthy') }], 'devops_engineer');
+}
+
+async function onDeliveryFinished(project: Project, execution: Execution, value: Json | null): Promise<void> {
+  const branch = typeof value?.branch === 'string' ? value.branch : null;
+  if (execution.status === 'completed' && value?.green === true && branch) {
+    const integration = await integrateBranch(project, branch, 'Merge delivery documentation');
+    if (integration.merged && project.repo_path) {
+      await syncCheckout(project);
+      const report = await readFile(join(project.repo_path, 'docs', 'delivery-report.md'), 'utf8').catch(() => null);
+      if (report) await db.addDocument({ project_id: project.id, kind: 'delivery-report', title: 'docs/delivery-report.md', content: report, run_id: execution.run_id });
+      await db.updateProject(project.id, { phase: 'COMPLETED', blocked_reason: null, last_error: null });
+      await db.addEvent({ project_id: project.id, kind: 'project.completed', message: `Delivered at ${integration.head ?? 'unknown'}` });
+      return;
+    }
+    await db.updateProject(project.id, { phase: 'BLOCKED', blocked_reason: `Delivery branch could not be integrated: ${integration.detail}` });
+    return;
+  }
+  await db.updateProject(project.id, { phase: 'BLOCKED', blocked_reason: `Delivery documentation failed: ${execution.error ?? String(value?.summary ?? 'no result')}` });
+}
+
+/* ------------------------------- operator actions ----------------------------- */
+
+export async function resumeProject(project: Project): Promise<Project> {
+  const tasks = await db.listTasks(project.id);
+  // Blocked and failed tasks go back to the backlog; the next tick readies those whose
+  // dependencies are complete, so a resume never runs a task ahead of what it depends on.
+  for (const task of tasks.filter(t => t.status === 'BLOCKED' || t.status === 'FAILED')) {
+    // `attempts` keeps counting (it keys the executions); the retry allowance restarts from here.
+    await db.updateTask(task.id, { status: 'BACKLOG', attempt_base: task.attempts, last_error: null });
+  }
+  const hasTasks = tasks.length > 0;
+  const phase: ProjectPhase = project.phase === 'BLOCKED' ? (hasTasks ? 'AUTONOMOUS_DEVELOPMENT' : 'PROJECT_CREATED') : project.phase;
+  const updated = await db.updateProject(project.id, { paused: 0, blocked_reason: null, last_error: null, phase, phase_entered_at: db.now() });
+  await db.addEvent({ project_id: project.id, kind: 'project.resumed', message: `Resumed in phase ${phase}` });
+  return updated as Project;
+}
+
+export function ensureUuid(value: string): string {
+  return /^[0-9a-f-]{36}$/i.test(value) ? value : randomUUID();
+}
