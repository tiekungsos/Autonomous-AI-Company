+        </Card>
+        <Card title="Staging deployments">
+          {deployments.length === 0 ? <p className="text-[12px] text-text-tertiary">None yet.</p> : (
+            <ul className="space-y-2">{deployments.map(d => <li key={d.id} className="text-[12px] text-text-secondary"><StatusPill status={d.status} /> <span className="font-mono text-[11px]">{d.compose_project}</span> {d.url ? <a className="text-sky-300 hover:underline" href={d.url} target="_blank" rel="noreferrer">{d.url}</a> : null}<div className="text-[11px] text-text-tertiary">{d.health}</div></li>)}</ul>
+          )}
