+export const companyLimits = (): Promise<Record<string, number>> => request('/api/company/limits');
+export const createCompanyProject = (input: CreateProjectInput): Promise<CompanyProject> => request('/api/company/projects', { method: 'POST', body: JSON.stringify(input) });
+export const updateCompanyProject = (id: string, patch: Partial<Pick<CompanyProject, 'engine' | 'budget_usd' | 'max_concurrency' | 'requirements'>>): Promise<CompanyProject> => request(`/api/company/projects/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify(patch) });
