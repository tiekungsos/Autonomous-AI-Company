# Copied to $ARCHON_HOME/.env by scripts/setup. Archon reads this file at boot.
# AI engines: Devin uses its own login (`devin auth login`); Claude uses `claude login`.
DEFAULT_AI_ASSISTANT=claude
CLAUDE_USE_GLOBAL_AUTH=true
# Server
# PORT=3090   # leave unset (Archon's default is 3090): a PORT here leaks into agents and generated projects' ${PORT}
HOST=127.0.0.1
ARCHON_TELEMETRY_DISABLED=true
# Company scheduler limits (section 22 of the brief)
MAX_CONCURRENT_AGENTS=3
MAX_TASK_RETRIES=3
MAX_REPAIR_ITERATIONS=5
MAX_REVIEW_ROUNDS=5
MAX_AGENT_EXECUTION_MINUTES=60
COMPANY_TICK_MS=5000
# COMPANY_SCHEDULER=off            # disable the tick loop (tests)
# COMPANY_MODEL_OVERRIDE=devin/swe-2-high  # test mode: one model for every role, tier and task size
# ARCHON_DEVIN_PERMISSION_MODE=bypass      # Devin without its OS sandbox, every tool auto-approved (agents can write anywhere your user can)
# COMPANY_ROLES_PATH=~/autonomous-ai-company/agents/roles.yaml
# COMPANY_DATA_DIR=$ARCHON_HOME/company
# Web authentication (optional; needs PostgreSQL). See docs/security.md.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/archon
# BETTER_AUTH_SECRET=                # openssl rand -base64 32
# ARCHON_AUTH_ALLOWED_EMAILS=you@example.com
# TOKEN_ENCRYPTION_KEY=              # openssl rand -hex 32 (per-user GitHub/provider keys)
# GitHub (optional; PR flows): GH_TOKEN= or `gh auth login`
